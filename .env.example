# ─── GoHighLevel delivery (server-side only; nothing here reaches the browser) ──
# The browser posts the form to /api/lead. That route forwards the lead to GHL via
# whichever of these paths is configured. Configure at least one.

# PATH 1 (recommended): Contacts API upsert. Creates/updates the contact in the
# Holigenix Healthcare sub-account, tags it "careers-site-lead", and fills the
# existing "Title (RN / LPN)", "Position Applied For", and "Referral Source" fields.
# Token: GHL → Settings → Private Integrations → token with contacts.write.
GHL_API_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_LOCATION_ID=rfZzMraSP58cwl2fJD5D

# PATH 2 (optional): a Workflow "Inbound Webhook" trigger URL. GHL: Automation →
# Workflows → trigger "Inbound Webhook" → copy the URL. The raw lead JSON is posted.
# (NEXT_PUBLIC_GHL_RECRUIT_WEBHOOK is still honoured as a legacy name.)
GHL_RECRUIT_WEBHOOK=

# ─── Site URL ───────────────────────────────────────────────────────────────
# Canonical URL of this deployment. Used for <link rel="canonical">, Open Graph
# tags, AND the QR code target (`npm run qr` encodes `${NEXT_PUBLIC_SITE_URL}/?src=qr-choa`).
# Defaults to https://careers.holigenixhealthcare.com when unset. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://careers.holigenixhealthcare.com
