# ─── GoHighLevel ────────────────────────────────────────────────────────────
# The GHL Workflow "Inbound Webhook" trigger URL. In GHL: Automation → Workflows
# → your recruiting workflow → trigger "Inbound Webhook" → copy the URL it shows.
# Server-side only: the browser posts to /api/lead, which forwards here. The URL
# never ships in the client bundle. Leave empty locally to test without sending.
# (NEXT_PUBLIC_GHL_RECRUIT_WEBHOOK is still honoured as a fallback name.)
GHL_RECRUIT_WEBHOOK=https://services.leadconnectorhq.com/hooks/XXXXXXXXXXXXXXXXXXXX/webhook-trigger/XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ─── Site URL ───────────────────────────────────────────────────────────────
# Canonical URL of this deployment. Used for <link rel="canonical">, Open Graph
# tags, AND the QR code target (`npm run qr` encodes `${NEXT_PUBLIC_SITE_URL}/?src=qr-choa`).
# Defaults to https://careers.holigenixhealthcare.com when unset. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://careers.holigenixhealthcare.com
